# Flask Config
FLASK_ENV=development
SECRET_KEY=luxoya-secret-key-change-in-production
JWT_SECRET_KEY=luxoya-jwt-secret-change-in-production

# Database (Neon PostgreSQL) - leave empty for local SQLite
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Razorpay (Live/Test)
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=yourkeysecret

# Google Gemini AI (AI Assistant)
GEMINI_API_KEY=your-gemini-api-key

# WhatsApp API (Meta Cloud API / Any generic provider)
WHATSAPP_API_TOKEN=your-whatsapp-bearer-token
WHATSAPP_API_URL=https://graph.facebook.com/v17.0/YOUR-PHONE-NUMBER-ID/messages

# Email (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=admin@luxoyacandles.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Deployment settings
ALLOW_SQLITE_FALLBACK=1
